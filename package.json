{
  "name": "evergrow-workspace",
  "private": true,
  "scripts": {
    "online:server": "npm --prefix game run online:server",
    "online:dev": "node scripts/dev-online.mjs",
    "online:remote": "node scripts/host-online.mjs",
    "online:remote:status": "node scripts/host-online.mjs status",
    "online:remote:stop": "node scripts/host-online.mjs stop",
    "online:test": "npm --prefix game run online:test && node --test scripts/online-proxy.test.mjs",
    "setup": "npm --prefix game ci",
    "dev": "npm --prefix game run dev",
    "build": "npm --prefix game run build",
    "build:site": "npm run typecheck && node scripts/stage-site.mjs",
    "typecheck": "npm --prefix game run typecheck",
    "check": "npm --prefix game run check && node --test scripts/online-proxy.test.mjs",
    "stats": "npm --prefix game run stats",
    "test": "npm --prefix game test",
    "test:browser": "npm --prefix game run test:browser",
    "android:build": "node scripts/build-android.mjs",
    "android:install": "node scripts/build-android.mjs --install",
    "release:check": "node --experimental-strip-types scripts/check-release.ts",
    "chromatic:content": "node --experimental-strip-types chromatic/tools/export-content.mjs",
    "chromatic:art": "node chromatic/tools/art.mjs",
    "chromatic:test": "node chromatic/tools/test.mjs",
    "chromatic:build": "npm run chromatic:content && npm run chromatic:test && node chromatic/tools/build.mjs",
    "chromatic:verify": "node chromatic/tools/validate-rom.mjs"
  }
}
